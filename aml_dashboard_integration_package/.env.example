# PostgreSQL / Supabase Database Connection
AML_DB_HOST=localhost
AML_DB_PORT=5432
AML_DB_NAME=aml_fcip
AML_DB_USER=postgres
AML_DB_PASSWORD=replace_with_your_local_password
AML_DB_SSLMODE=prefer

# Supabase Authentication & Project Settings
# Get these from your Supabase Project Settings -> API & Auth
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Optional Legacy HTTP Basic Auth (leave empty if using Supabase Auth)
AML_APP_USERNAME=
AML_APP_PASSWORD=
